      "sourceIdsFrom": "日主与强弱的现有来源"
    }
  },
  "takeaway": {
    "selectionRule": "只按STRENGTH_KEY查表，不新增事实",
    "byStrength": {
      "strong": {
        "body": "把充足的力气用在一件能交付的事上，并给协作留一个入口。"
      },
      "weak": {
        "body": "先补支点和节奏，再把有限的力气投向真正重要的一步。"
      },
      "balanced": {
        "body": "从能做的许多事里选一件，连续做深，别让平衡变成停留。"
      }
    }
  },
  "shareClip": {
    "allowedOutputKeys": [
      "identity",
      "strength",
      "tension",
      "actionAdvice",
      "brand"
    ],
    "outputTemplate": {
      "identity": "{{STEM_IDENTITY_TITLE}}",
      "strength": "{{STRENGTH_LABEL}}",
      "tension": "{{TENSION_BODY}}",
      "actionAdvice": "{{TAKEAWAY_BODY}}",
      "brand": "知星｜命盘研究所"
    },
    "sourceRules": {
      "identity": "stems[STEM_KEY].identityTitle",
      "strength": "strengths[STRENGTH_KEY].label",
      "tension": "已选中的tension幕正文",
      "actionAdvice": "已选中的takeaway幕正文",
      "brand": "brand常量"
    }
  }
}
