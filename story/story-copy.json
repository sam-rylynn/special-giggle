{
  "version": "story-copy-v1",
  "contentVersion": "copy-v1",
  "locale": "zh-CN",
  "brand": "知星｜命盘研究所",
  "sceneOrder": [
    "identity",
    "energy",
    "tension",
    "mirror",
    "phase",
    "takeaway"
  ],
  "constraints": {
    "sceneBodyMaxCharacters": 64,
    "oneCorePointPerScene": true,
    "strengthKeys": [
      "strong",
      "weak",
      "balanced"
    ],
    "shareClipOutputKeys": [
      "identity",
      "strength",
      "tension",
      "actionAdvice",
      "brand"
    ],
    "publicSourceIdsRequired": true,
    "allowNewChartClaims": false
  },
  "selectorMaps": {
    "strengthLabelToKey": {
      "偏强": "strong",
      "偏弱": "weak",
      "中和": "balanced"
    },
    "elementLabelToKey": {
      "木": "wood",
      "火": "fire",
      "土": "earth",
      "金": "metal",
      "水": "water"
    },
    "luminaryLabelToKey": {
      "太阳": "sun",
      "月亮": "moon",
      "上升": "asc"
    }
  },
  "placeholderRegistry": {
    "{{STEM_KEY}}": {
      "type": "lookup_key",
      "allowedSource": "dayMaster.stem",
      "fallback": "stop_story"
    },
    "{{STEM_IDENTITY_TITLE}}": {
      "type": "copy_lookup",
      "allowedSource": "stems[STEM_KEY].identityTitle",
      "fallback": "stop_story"
    },
    "{{STEM_AXIS}}": {
      "type": "copy_lookup",
      "allowedSource": "stems[STEM_KEY].axis",
      "fallback": "stop_story"
    },
    "{{STRENGTH_KEY}}": {
      "type": "lookup_key",
      "allowedSource": "resolvedStrengthKey",
      "fallback": "stop_story"
    },
    "{{STRENGTH_LABEL}}": {
      "type": "copy_lookup",
      "allowedSource": "strengths[STRENGTH_KEY].label",
      "fallback": "stop_story"
    },
    "{{STRENGTH_POSTURE}}": {
      "type": "copy_lookup",
      "allowedSource": "strengths[STRENGTH_KEY].posture",
      "fallback": "stop_story"
    },
    "{{DAY_MASTER_SOURCE_ID}}": {
      "type": "source_id",
      "allowedSource": "existingReportSourceIds.dayMaster",
      "fallback": "stop_story"
    },
    "{{STRENGTH_SOURCE_ID}}": {
      "type": "source_id",
      "allowedSource": "existingReportSourceIds.strength",
      "fallback": "stop_story"
    },
    "{{HIGH_ELEMENT_KEY}}": {
      "type": "lookup_key",
      "allowedSource": "resolvedEnergy.highElement",
      "fallback": "stop_story"
    },
    "{{HIGH_ELEMENT_LABEL}}": {
      "type": "copy_lookup",
      "allowedSource": "elements[HIGH_ELEMENT_KEY].label",
      "fallback": "stop_story"
    },
    "{{ELEMENT_HIGH_LINE}}": {
      "type": "copy_lookup",
      "allowedSource": "elements[HIGH_ELEMENT_KEY].high",
      "fallback": "stop_story"
    },
    "{{LOW_ELEMENT_KEY}}": {
      "type": "lookup_key",
      "allowedSource": "resolvedEnergy.lowElement",
      "fallback": "stop_story"
    },
    "{{LOW_ELEMENT_LABEL}}": {
      "type": "copy_lookup",
      "allowedSource": "elements[LOW_ELEMENT_KEY].label",
      "fallback": "stop_story"
    },
    "{{ELEMENT_LOW_LINE}}": {
      "type": "copy_lookup",
      "allowedSource": "elements[LOW_ELEMENT_KEY].low",
      "fallback": "stop_story"
    },
    "{{ENERGY_SOURCE_IDS}}": {
      "type": "source_id_array",
      "allowedSource": "existingReportSourceIds.energy",
      "fallback": "stop_story"
    },
    "{{TENSION_LUMINARY_KEY}}": {
      "type": "lookup_key",
      "allowedSource": "resolvedCross.luminaryKey",
      "fallback": "cross.safeFallbacks"
    },
    "{{TENSION_MODE}}": {
      "type": "lookup_key",
      "allowedSource": "resolvedCross.mode",
      "fallback": "cross.safeFallbacks"
    },
    "{{TENSION_HEADLINE}}": {
      "type": "copy_lookup",
      "allowedSource": "cross.byLuminary[TENSION_LUMINARY_KEY][TENSION_MODE].headline",
      "fallback": "cross.safeFallbacks"
    },
    "{{TENSION_BODY}}": {
      "type": "copy_lookup",
      "allowedSource": "cross.byLuminary[TENSION_LUMINARY_KEY][TENSION_MODE].body",
      "fallback": "cross.safeFallbacks"
    },
    "{{TENSION_SOURCE_IDS}}": {
      "type": "source_id_array",
      "allowedSource": "resolvedCross.sourceIds",
      "fallback": "cross.safeFallbacks"
    },
    "{{MIRROR_MODE}}": {
      "type": "lookup_key",
      "allowedSource": "resolvedMirror.mode",
      "fallback": "mirror.safeFallbacks"
    },
    "{{MIRROR_HEADLINE}}": {
      "type": "copy_lookup",
      "allowedSource": "mirror.modes[MIRROR_MODE].headline",
      "fallback": "mirror.safeFallbacks"
    },
    "{{MIRROR_BODY}}": {
      "type": "copy_lookup",
      "allowedSource": "mirror.modes[MIRROR_MODE].body",
      "fallback": "mirror.safeFallbacks"
    },
    "{{MIRROR_SOURCE_IDS}}": {
      "type": "source_id_array",
      "allowedSource": "resolvedMirror.sourceIds",
      "fallback": "mirror.safeFallbacks"
    },
    "{{CURRENT_DAYUN_GOD}}": {
      "type": "lookup_key",
      "allowedSource": "resolvedCurrentDaYun.god",
      "fallback": "phase.missing"
    },
    "{{PHASE_HEADLINE}}": {
      "type": "copy_lookup",
      "allowedSource": "phase.byTenGod[CURRENT_DAYUN_GOD].headline",
      "fallback": "phase.missing.headline"
    },
    "{{PHASE_BODY}}": {
      "type": "copy_lookup",
      "allowedSource": "phase.byTenGod[CURRENT_DAYUN_GOD].body",
      "fallback": "phase.missing.body"
    },
    "{{PHASE_SOURCE_IDS}}": {
      "type": "source_id_array",
      "allowedSource": "resolvedCurrentDaYun.sourceIds",
      "fallback": "phase.missing.sourceIdsFrom"
    },
    "{{TAKEAWAY_BODY}}": {
      "type": "copy_lookup",
      "allowedSource": "takeaway.byStrength[STRENGTH_KEY].body",
      "fallback": "stop_story"
    },
    "{{TAKEAWAY_SOURCE_IDS}}": {
      "type": "source_id_array",
      "allowedSource": "previousSceneSourceIds",
      "fallback": "stop_story"
    }
  },
  "scenes": {
    "identity": {
      "sceneId": "identity",
      "eyebrow": "你的主轴",
      "headlineTemplate": "{{STEM_IDENTITY_TITLE}} · {{STRENGTH_LABEL}}",
      "bodyTemplate": "{{STEM_AXIS}}",
      "selectorKeys": [
        "{{STEM_KEY}}",
        "{{STRENGTH_KEY}}"
      ],
      "sourceIdTemplates": [
        "{{DAY_MASTER_SOURCE_ID}}",
        "{{STRENGTH_SOURCE_ID}}"
      ],
      "shareSafe": true,
      "maxBodyCharacters": 64
    },
    "energy": {
      "sceneId": "energy",
      "eyebrow": "你的能量",
      "headlineTemplate": "{{HIGH_ELEMENT_LABEL}}更足 · {{LOW_ELEMENT_LABEL}}更轻 · {{STRENGTH_LABEL}}",
      "bodyTemplate": "{{STRENGTH_POSTURE}} {{ELEMENT_HIGH_LINE}} {{ELEMENT_LOW_LINE}}",
      "selectorKeys": [
        "{{HIGH_ELEMENT_KEY}}",
        "{{LOW_ELEMENT_KEY}}",
        "{{STRENGTH_KEY}}"
      ],
      "sourceIdsFrom": "{{ENERGY_SOURCE_IDS}}",
      "shareSafe": false,
      "maxBodyCharacters": 64
    },
    "tension": {
      "sceneId": "tension",
      "eyebrow": "最值得记住的张力",
      "headlineTemplate": "{{TENSION_HEADLINE}}",
      "bodyTemplate": "{{TENSION_BODY}}",
      "selectorKeys": [
        "{{TENSION_LUMINARY_KEY}}",
        "{{TENSION_MODE}}"
      ],
      "sourceIdsFrom": "{{TENSION_SOURCE_IDS}}",
      "shareSafe": true,
      "maxBodyCharacters": 64
    },
    "mirror": {
      "sceneId": "mirror",
      "eyebrow": "里外之间",
      "headlineTemplate": "{{MIRROR_HEADLINE}}",
      "bodyTemplate": "{{MIRROR_BODY}}",
      "selectorKeys": [
        "{{MIRROR_MODE}}"
      ],
      "sourceIdsFrom": "{{MIRROR_SOURCE_IDS}}",
      "shareSafe": false,
      "maxBodyCharacters": 64
    },
    "phase": {
      "sceneId": "phase",
      "eyebrow": "此刻的进与收",
      "headlineTemplate": "{{PHASE_HEADLINE}}",
      "bodyTemplate": "{{PHASE_BODY}}",
      "selectorKeys": [
        "{{CURRENT_DAYUN_GOD}}"
      ],
      "sourceIdsFrom": "{{PHASE_SOURCE_IDS}}",
      "shareSafe": false,
      "maxBodyCharacters": 64
    },
    "takeaway": {
      "sceneId": "takeaway",
      "eyebrow": "带走这一句",
      "headlineTemplate": "把方向落到下一步",
      "bodyTemplate": "{{TAKEAWAY_BODY}}",
      "selectorKeys": [
        "{{STRENGTH_KEY}}"
      ],
      "sourceIdsFrom": "{{TAKEAWAY_SOURCE_IDS}}",
      "shareSafe": true,
      "maxBodyCharacters": 64
    }
  },
  "stems": {
