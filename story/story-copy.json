      "label": "水",
      "high": "水意更足，感知和转向更灵活。",
      "low": "水意更轻，先给自己多一种可能。"
    }
  },
  "cross": {
    "modeKeys": [
      "verification",
      "contrast"
    ],
    "relationKeyToMode": {
      "sameQi": "verification",
      "generateMe": "verification",
      "iGenerate": "verification",
      "tension": "contrast"
    },
    "byLuminary": {
      "sun": {
        "verification": {
          "headline": "外在方向与内核同路",
          "body": "太阳呈现的外在方向与日主互相印证，行动时较少需要扮成另一种人。"
        },
        "contrast": {
          "headline": "外在方向与内核拉扯",
          "body": "太阳呈现的外在方向与日主形成反差，你常在被看见与守住自己之间换挡。"
        }
      },
      "moon": {
        "verification": {
          "headline": "情绪底色与内核同路",
          "body": "月亮呈现的内在感受与日主互相印证，你较容易承认自己真正的情绪。"
        },
        "contrast": {
          "headline": "情绪底色与内核拉扯",
          "body": "月亮呈现的内在感受与日主形成反差，亲近之后才看得到你的另一层。"
        }
      },
      "asc": {
        "verification": {
          "headline": "第一印象与内核同路",
          "body": "上升呈现的第一印象与日主互相印证，别人较容易从初见读到真实的你。"
        },
        "contrast": {
          "headline": "第一印象与内核错位",
          "body": "上升呈现的第一印象与日主形成反差，熟悉之后别人常会重新认识你。"
        }
      }
    },
    "safeFallbacks": {
      "missingMoon": {
        "useLuminaryOrder": [
          "sun"
        ],
        "rule": "不补写情绪底色"
      },
      "missingAsc": {
        "useLuminaryOrder": [
          "moon",
          "sun"
        ],
        "rule": "不补写第一印象"
      },
      "missingMoonAndAsc": {
        "headline": "只保留已知互证",
        "body": "月亮与上升信息不足，本幕只保留日主与太阳之间已经确认的关系。",
        "sourceIdsFrom": "日主与太阳的现有来源"
      }
    }
  },
  "mirror": {
    "modes": {
      "aligned": {
        "headline": "里外彼此点头",
        "body": "内在感受与外在呈现彼此靠近，别人较容易读到真实的你。"
      },
      "contrast": {
        "headline": "里外各有一套语言",
        "body": "内在感受与外在呈现不完全同路，熟悉之后才看得到你的另一面。"
      },
      "dual_contrast": {
        "headline": "里外都藏着另一层",
        "body": "内在感受与外在呈现都和日主形成反差，你的层次需要在相处中慢慢展开。"
      },
      "moon_only": {
        "headline": "先照见内在",
        "body": "本幕只使用已知的月亮信息，描述内在感受，不补写外在呈现。"
      },
      "asc_only": {
        "headline": "先看见外在",
        "body": "本幕只使用已知的上升信息，描述第一印象，不补写内在感受。"
      },
      "sun_only": {
        "headline": "只保留已知互证",
        "body": "月亮与上升信息不足，本幕只保留日主与太阳已经确认的关系。"
      }
    },
    "safeFallbacks": {
      "missingMoon": "asc_only",
      "missingAsc": "moon_only",
      "missingMoonAndAsc": "sun_only"
    },
    "modeSelection": {
      "moon_verification_and_asc_verification": "aligned",
      "one_verification_and_one_contrast": "contrast",
      "moon_contrast_and_asc_contrast": "dual_contrast"
    }
  },
  "phase": {
    "byTenGod": {
      "比肩": {
        "headline": "把主线收回自己手里",
